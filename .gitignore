# Root .gitignore for Developer Portfolio (Laravel 11 Backend + Vue 3 Frontend)

# Dependencies
frontend/node_modules/
backend/vendor/

# Build artifacts
frontend/dist/
frontend/.cache/

# Environment files
backend/.env
backend/.env.backup
backend/.env.production
frontend/.env.local
frontend/.env.*.local

# Laravel storage & logs
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php

# SQLite database (optional, omit if storing clean schema)
backend/database/database.sqlite-journal

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
